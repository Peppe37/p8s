# P8s Demo Configuration
# Copy this file to .env and customize

P8S_DEBUG=true
P8S_SECRET_KEY=demo-secret-key-change-in-production
P8S_APP_NAME=P8s Demo

# Database (SQLite for demo)
P8S_DB_URL=sqlite+aiosqlite:///./db.sqlite3

# CORS (allow frontend dev server)
P8S_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Admin Panel
P8S_ADMIN_ENABLED=true
P8S_ADMIN_TITLE=P8s Demo Admin

# Auth
P8S_AUTH_SECRET_KEY=demo-jwt-secret-change-in-production
P8S_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI (optional - uncomment and add your key)
# P8S_AI_PROVIDER=openai
# P8S_AI_OPENAI_API_KEY=sk-your-api-key-here
# P8S_AI_MODEL=gpt-4o-mini
